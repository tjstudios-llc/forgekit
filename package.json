{
  "name":"forgekit","version":"0.2.0","private":true,
  "description":"Local-first application generator with CLI, VS Code, and desktop interfaces.",
  "type":"module","engines":{"node":">=22"},"packageManager":"pnpm@10.20.0",
  "scripts":{
    "dev":"node ./apps/cli/bin/forgekit.js","cli":"node ./apps/cli/bin/forgekit.js",
    "test":"node --test packages/core/test/*.test.js",
    "lint:check":"node --check ./apps/cli/bin/forgekit.js && node --check ./apps/cli/src/cli.js && node --check ./packages/core/src/generator/create-project.js && node --check ./packages/core/src/database/postgres.js",
    "build:vscode":"pnpm --filter @forgekit/vscode build",
    "desktop:dev":"pnpm --filter @forgekit/desktop dev",
    "desktop:linux":"pnpm --filter @forgekit/desktop build:linux",
    "desktop:windows":"pnpm --filter @forgekit/desktop build:windows"
  }
}